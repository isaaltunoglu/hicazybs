# App settings
TSC_COMPILE_ON_ERROR=true
BROWSER=none
PORT=3000

# Firebase (Frontend)
REACT_APP_FIREBASE_API_KEY=your-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=1234567890
REACT_APP_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional: Default White-Label Organization Fallbacks
REACT_APP_ORG_NAME=Kurumsal YBS
REACT_APP_ORG_SUBTITLE=Çoklu Şirket & Takım Yönetim Bilişim Sistemi
REACT_APP_WORKSPACE_LABEL=Çalışma Alanı

# Optional: comma-separated allow-list for emergency super admin access
REACT_APP_SUPERADMIN_EMAILS=admin@example.com
